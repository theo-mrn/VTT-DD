# Valeurs factices pour « next build » : certaines routes API instancient Stripe, Resend, R2…
# au chargement du module. Aucune valeur réelle ici ; en production elles viennent des Secrets k8s.
# Les NEXT_PUBLIC_* réels sont passés en build-args au build de l'image de release.
R2_ACCESS_KEY_ID=ci-placeholder
R2_SECRET_ACCESS_KEY=ci-placeholder
R2_ENDPOINT=https://example.invalid
R2_BUCKET_NAME=ci-placeholder
R2_PUBLIC_URL=https://example.invalid
RESEND_API_KEY=ci-placeholder
RESEND_AUDIANCE_KEY=ci-placeholder
NEXT_PUBLIC_APP_URL=http://localhost:3000
GEMINI_API_KEY=ci-placeholder
NO_PROJECT=ci-placeholder
DEEPL_API_KEY=ci-placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=ci-placeholder
STRIPE_SECRET_KEY=ci-placeholder
STRIPE_WEBHOOK_SECRET=ci-placeholder
CRON_SECRET=ci-placeholder
NEXT_PUBLIC_FIREBASE_API_KEY=ci-placeholder
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ci-placeholder
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://ci-placeholder.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ci-placeholder
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ci-placeholder
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=ci-placeholder
NEXT_PUBLIC_FIREBASE_APP_ID=ci-placeholder
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=ci-placeholder
FIREBASE_SERVICE_ACCOUNT_KEY=
DISCORD_TOKEN=ci-placeholder
DISCORD_APPLICATION_ID=ci-placeholder
DISCORD_PUBLIC_KEY=ci-placeholder
METERED_APP_NAME=ci-placeholder
METERED_API_KEY=ci-placeholder
