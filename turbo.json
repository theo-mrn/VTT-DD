{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@vtt/web#build": {
      "dependsOn": ["^build", "@vtt/web#typecheck"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*"],
      "passThroughEnv": [
        "STRIPE_*",
        "RESEND_*",
        "R2_*",
        "GEMINI_API_KEY",
        "DEEPL_API_KEY",
        "CRON_SECRET",
        "FIREBASE_*",
        "DISCORD_*",
        "METERED_*",
        "NO_PROJECT"
      ]
    }
  }
}
