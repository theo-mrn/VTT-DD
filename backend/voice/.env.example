# Copié en .env par `pnpm dev` s'il manque.
PORT=3012
# Jetons d'accès émis par identity, vérifiés par son JWKS (mêmes valeurs que la gateway)
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=vtt-api
JWKS_URL=http://localhost:3001/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Secret partagé entre services (en-tête x-internal-secret), 32 caractères minimum :
# même valeur que dans backend/campaign/.env. Vide : voix indisponible (droits inconnus).
INTERNAL_API_SECRET=dev-secret-interne-local-0123456789abcdef
# Campagnes (campaign) : rôle de l'appelant (membre, MJ, spectateur)
CAMPAIGN_URL=http://localhost:3003

# Bus NATS JetStream (docker compose) : annonces voice.joined, voice.updated, voice.left
NATS_URL=nats://127.0.0.1:4222
# Valkey (docker compose) : salle vocale de chaque campagne ; vide : en mémoire (un seul réplica)
REDIS_URL=redis://127.0.0.1:6379

# Cloudflare Realtime (docs/voix.md § 10) : application SFU et clé TURN. Vides : voix
# indisponible (503 voice_unconfigured), le reste de la table fonctionne.
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_TOKEN=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_TOKEN=

# Requêtes par minute et par IP pour ce service (300 en prod ; large en local)
RATE_LIMIT_MAX=3000
