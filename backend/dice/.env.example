# Copié en .env par `pnpm dev` s'il manque.
PORT=3004
# Rôle du service (données uniquement) ; le schéma « dice » est migré par Liquibase
DATABASE_URL=postgres://dice_svc:dice-dev@localhost:5432/vtt
# Jetons d'accès émis par identity, vérifiés par son JWKS (mêmes valeurs que la gateway)
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=vtt-api
JWKS_URL=http://localhost:3001/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Secret partagé entre services (en-tête x-internal-secret), 32 caractères minimum :
# même valeur dans backend/campaign/.env, backend/character/.env, backend/identity/.env
# et backend/gateway/.env. Vide : ni jet de campagne, ni jet de personnage, ni route interne.
INTERNAL_API_SECRET=dev-secret-interne-local-0123456789abcdef
# Campagnes (campaign) : rôle de l'appelant, système et personnage incarné
CAMPAIGN_URL=http://localhost:3003
# Personnages (character) : fiche lue pour les variables des notations (1d20+FOR)
CHARACTER_URL=http://localhost:3002
# Profils publics (noms, avatars) des lanceurs sans personnage. Vide : « Aventurier ».
IDENTITY_URL=http://localhost:3001

# Jets par minute : par IP (route), et par utilisateur (compté en base)
RATE_LIMIT_ROLLS_MAX=120
RATE_LIMIT_ROLLS_PER_USER=60
# Requêtes par minute et par IP pour ce service (300 en prod ; large en local : les tests de
# bout en bout tournent tous depuis la même adresse)
RATE_LIMIT_MAX=3000
