# Copié en .env par `pnpm dev` s'il manque.
PORT=3011
# Rôle du service (données uniquement) ; le schéma « marketplace » est migré par Liquibase
DATABASE_URL=postgres://marketplace_svc:marketplace-dev@localhost:5432/vtt
# Jetons d'accès émis par identity, vérifiés par son JWKS (mêmes valeurs que la gateway)
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=vtt-api
JWKS_URL=http://localhost:3001/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Secret partagé entre services (en-tête x-internal-secret), même valeur que campaign et billing
INTERNAL_API_SECRET=dev-secret-interne-local-0123456789abcdef
# Campagnes : rôle de l'appelant (seul le MJ installe un pack)
CAMPAIGN_URL=http://localhost:3003
# Paiement : sessions Stripe Checkout des ventes (billing)
BILLING_URL=http://localhost:3007

# Fichiers sur R2, même en dev : valeurs R2_* de ~/.config/vtt/staging.env
R2_ENDPOINT=
R2_BUCKET_NAME=vtt-dd-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://assets.yner.fr

# Vente des packs : off (gratuit seulement) tant que STRIPE_CONNECT n'est pas on dans billing
MARKETPLACE_PAID_LISTINGS=off
# Comptes modérateurs : identifiants (uuid) séparés par des virgules
MARKETPLACE_MODERATORS=

# Bus NATS local (ajouté par `pnpm dev`) : outbox, ventes et comptes des créateurs
NATS_URL=nats://127.0.0.1:4222
# Requêtes par minute et par IP pour ce service (300 en prod ; large en local : les tests de
# bout en bout tournent tous depuis la même adresse)
RATE_LIMIT_MAX=3000
