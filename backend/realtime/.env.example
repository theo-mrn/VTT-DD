# Copié en .env par `pnpm dev` s'il manque.
PORT=3006
# Jetons d'accès émis par identity, vérifiés par son JWKS (mêmes valeurs que la gateway)
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=vtt-api
JWKS_URL=http://localhost:3001/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Bus NATS JetStream : diffusion des événements et rejeu après reconnexion.
# Vide : seul le canal éphémère (curseurs, présence) fonctionne.
NATS_URL=nats://127.0.0.1:4222
# Valkey : cache des droits et adaptateur Socket.IO entre réplicas (vide : mémoire, un seul réplica)
REDIS_URL=redis://127.0.0.1:6379

# Secret partagé entre services (en-tête x-internal-secret), 32 caractères minimum :
# même valeur que dans backend/campaign/.env. Vide : aucun abonnement à une campagne.
INTERNAL_API_SECRET=dev-secret-interne-local-0123456789abcdef
# Campagnes (campaign) : appartenance et rôle de l'abonné
CAMPAIGN_URL=http://localhost:3003
# Requêtes par minute et par IP pour ce service (300 en prod ; large en local : les tests de
# bout en bout tournent tous depuis la même adresse)
RATE_LIMIT_MAX=3000
