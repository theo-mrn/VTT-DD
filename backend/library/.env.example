# Copié en .env par `pnpm dev` s'il manque.
PORT=3013
# Rôle du service (données uniquement) ; le schéma « library » est migré par Liquibase
DATABASE_URL=postgres://library_svc:library-dev@localhost:5432/vtt
# Jetons d'accès émis par identity, vérifiés par son JWKS (mêmes valeurs que la gateway)
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=vtt-api
JWKS_URL=http://localhost:3001/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_MAX=3000

# ── Import seulement (pnpm --filter @vtt/library import) ──
# Fichiers sur R2 (bucket partagé, même en dev) : valeurs R2_* des autres services
R2_ENDPOINT=
R2_BUCKET_NAME=vtt-dd-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://assets.yner.fr
# Description des images par Claude : clé de l'API (jamais commitée), modèle et effort
ANTHROPIC_API_KEY=
LIBRARY_DESCRIBE_MODEL=claude-opus-5-5
LIBRARY_DESCRIBE_EFFORT=medium
