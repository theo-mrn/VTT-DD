# Copié en .env par `pnpm dev` s'il manque.
PORT=3014
# Rôle du service (données uniquement) ; le schéma « archive » est migré par Liquibase
DATABASE_URL=postgres://archive_svc:archive-dev@localhost:5432/vtt
# Jetons d'accès émis par identity, vérifiés par son JWKS (mêmes valeurs que la gateway)
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=vtt-api
JWKS_URL=http://localhost:3001/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Secret partagé entre services (en-tête x-internal-secret), même valeur que campaign
INTERNAL_API_SECRET=dev-secret-interne-local-0123456789abcdef
# Services dont les tables entrent dans une archive (docs/export-campagne.md § 5.5)
CAMPAIGN_URL=http://localhost:3003
CHARACTER_URL=http://localhost:3002
AUDIO_URL=http://localhost:3008

# Fichiers sur R2, même en dev : valeurs R2_* de ~/.config/vtt/staging.env
R2_ENDPOINT=
R2_BUCKET_NAME=vtt-dd-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://assets.yner.fr

# Bus NATS local (ajouté par `pnpm dev`) : outbox, comptes supprimés
NATS_URL=nats://127.0.0.1:4222
RATE_LIMIT_MAX=3000
