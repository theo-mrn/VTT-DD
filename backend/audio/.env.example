# Copié en .env par `pnpm dev` s'il manque.
PORT=3008
# Rôle du service (données uniquement) ; le schéma « audio » est migré par Liquibase
DATABASE_URL=postgres://audio_svc:audio-dev@localhost:5432/vtt
# Jetons d'accès émis par identity, vérifiés par son JWKS (mêmes valeurs que la gateway)
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=vtt-api
JWKS_URL=http://localhost:3001/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Secret partagé entre services (en-tête x-internal-secret), même valeur que campaign
INTERNAL_API_SECRET=dev-secret-interne-local-0123456789abcdef
# Campagnes (campaign) : rôle de l'appelant (MJ, joueur, spectateur)
CAMPAIGN_URL=http://localhost:3003

# Fichiers : SeaweedFS en dev, R2 en prod (mêmes valeurs que backend/campaign/.env)
S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_BUCKET=vtt-dev
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev-secret
S3_PUBLIC_URL=http://localhost:8333/vtt-dev
# Signe les jetons d'envoi (32 caractères minimum ; valeur de DEV seulement)
AUDIO_UPLOAD_SECRET=dev-secret-envoi-audio-0123456789abcdef
# Catalogue intégré : origines admises (le catalogue Star Wars est publié dans le bucket)
AUDIO_CATALOG_ORIGINS=https://assets.yner.fr

# Worker (même .env) : binaires ffmpeg (brew install ffmpeg en local), sondes sur WORKER_PORT
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WORKER_PORT=3009
WORKER_CONCURRENCY=2
WORKER_TMP_DIR=/tmp
# Requêtes par minute et par IP pour ce service (300 en prod ; large en local : les tests de
# bout en bout tournent tous depuis la même adresse)
RATE_LIMIT_MAX=3000
