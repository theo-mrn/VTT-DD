{
  "name": "@vtt/discord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "commands:register": "node dist/register-commands.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "prettier --check src"
  },
  "dependencies": {
    "@vtt/platform": "workspace:*",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  },
  "files": [
    "dist"
  ]
}
