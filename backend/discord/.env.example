# Service discord : bot de dés (docs/discord.md)
NODE_ENV=development
LOG_LEVEL=info
PORT=3010

# Application Discord (portail des développeurs) : mêmes valeurs que DISCORD_* du legacy
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Enregistrement des commandes seulement (pnpm --filter @vtt/discord commands:register)
DISCORD_BOT_TOKEN=

# Jetons délégués (identity) puis appels des services au nom du joueur
INTERNAL_API_SECRET=dev-secret-interne-local-0123456789abcdef
IDENTITY_URL=http://localhost:3001
CAMPAIGN_URL=http://localhost:3003
DICE_URL=http://localhost:3004
CHARACTER_URL=http://localhost:3002
APP_URL=http://localhost:3000
