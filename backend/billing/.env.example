# Copié en .env par `pnpm dev` s'il manque.
PORT=3007
# Rôle du service (données uniquement) ; le schéma « billing » est migré par Liquibase
DATABASE_URL=postgres://billing_svc:billing-dev@localhost:5432/vtt
# Jetons d'accès émis par identity, vérifiés par son JWKS (mêmes valeurs que la gateway)
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=vtt-api
JWKS_URL=http://localhost:3001/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Front : retours de Stripe Checkout (/paiement/succes, /paiement/annule) et du portail
APP_URL=http://localhost:3000

# Stripe, MODE TEST uniquement en local (https://dashboard.stripe.com/test/apikeys) ;
# clés live hors du dépôt, dans ~/.config/vtt/prod.env.
# Vides : le service démarre, les routes de paiement répondent 503 billing_unconfigured.
STRIPE_SECRET_KEY=
# Webhook local : `stripe listen --forward-to localhost:8080/v1/billing/webhook` affiche le whsec_…
STRIPE_WEBHOOK_SECRET=
# Prix : créés dans Stripe par `pnpm --filter @vtt/billing catalog:sync --apply` (lookup_key)
# TVA par Stripe Tax : on le jour où le statut fiscal l'exige (docs/paiement.md, « TVA »)
STRIPE_TAX=off

# Bus NATS local (ajouté par `pnpm dev`) : droits publiés pour dice et identity
NATS_URL=nats://127.0.0.1:4222
# Requêtes par minute et par IP pour ce service (300 en prod ; large en local : les tests de
# bout en bout tournent tous depuis la même adresse)
RATE_LIMIT_MAX=3000
