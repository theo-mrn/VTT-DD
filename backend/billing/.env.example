# Copié en .env par `pnpm dev` s'il manque.
PORT=3007
# Rôle du service (données uniquement) ; le schéma « billing » est migré par Liquibase
DATABASE_URL=postgres://billing_svc:billing-dev@localhost:5432/vtt
# Jetons d'accès émis par identity, vérifiés par son JWKS (mêmes valeurs que la gateway)
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=vtt-api
JWKS_URL=http://localhost:3001/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Front : retours de Stripe Checkout (/checkout/success, /checkout/cancel) et du portail
APP_URL=http://localhost:3000

# Stripe, MODE TEST uniquement en local (https://dashboard.stripe.com/test/apikeys).
# Vides : le service démarre, les routes de paiement répondent 503 billing_unconfigured.
STRIPE_SECRET_KEY=
# Webhook local : `stripe listen --forward-to localhost:8080/v1/billing/webhook` affiche le whsec_…
STRIPE_WEBHOOK_SECRET=
# Prix récurrent du premium (price_…) ; vide : 4,99 €/mois décrit dans la session
STRIPE_PREMIUM_PRICE_ID=

# Secret partagé entre services (en-tête x-internal-secret), 32 caractères minimum :
# même valeur que dans backend/dice/.env et backend/identity/.env
INTERNAL_API_SECRET=dev-secret-interne-local-0123456789abcdef
# Livraison des paiements : skins et premium (dice), badge premium (identity)
DICE_URL=http://localhost:3004
IDENTITY_URL=http://localhost:3001
