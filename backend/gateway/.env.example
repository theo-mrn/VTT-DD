PORT=8080
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=vtt-api
JWKS_URL=http://localhost:3001/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
UPSTREAM_IDENTITY_URL=http://localhost:3001
# Personnages et systèmes de jeu
UPSTREAM_CHARACTER_URL=http://localhost:3002
# Salles, invitations et combat
UPSTREAM_CAMPAIGN_URL=http://localhost:3003
# Jets de dés, historique, statistiques et préférences de dés
UPSTREAM_DICE_URL=http://localhost:3004
# Paiements Stripe : boutique, premium, factures ; webhook /v1/billing/webhook sans jeton
UPSTREAM_BILLING_URL=http://localhost:3007
UPSTREAM_DISCORD_URL=http://localhost:3010
# Temps réel : WebSocket Socket.IO (/v1/realtime/socket.io) et jeton du handshake
UPSTREAM_REALTIME_URL=http://localhost:3006
# Journal d'historique : timeline d'une campagne, vérification de la chaîne de hash
UPSTREAM_HISTORY_URL=http://localhost:3005
# Son : bibliothèque, canaux musique et ambiance, effets, horloge, mixeur (service audio)
UPSTREAM_AUDIO_URL=http://localhost:3008
# Packs des créateurs : catalogue, studio, bibliothèque, modération (service marketplace)
UPSTREAM_MARKETPLACE_URL=http://localhost:3011
# Voix à la table : salle vocale, signalisation du SFU (service voice)
UPSTREAM_VOICE_URL=http://localhost:3012

# Secret partagé avec identity pour échanger les clés d'API (« Authorization: ApiKey … »).
# Même valeur que INTERNAL_API_SECRET dans backend/identity/.env, 32 caractères minimum.
# Vide : les clés d'API sont refusées (401).
INTERNAL_API_SECRET=dev-secret-interne-local-0123456789abcdef
# Requêtes par minute et par IP pour ce service (300 en prod ; large en local : les tests de
# bout en bout tournent tous depuis la même adresse)
RATE_LIMIT_MAX=3000
