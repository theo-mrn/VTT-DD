# Copié en .env par `pnpm dev` s'il manque.
PORT=3003
# Rôle du service (données uniquement) ; le schéma « campaign » est migré par Liquibase
DATABASE_URL=postgres://campaign_svc:campaign-dev@localhost:5432/vtt
# Jetons d'accès émis par identity, vérifiés par son JWKS (mêmes valeurs que la gateway)
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=vtt-api
JWKS_URL=http://localhost:3001/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Secret partagé entre services (en-tête x-internal-secret), 32 caractères minimum :
# même valeur dans backend/character/.env, backend/identity/.env et backend/gateway/.env.
# Vide : pas de route interne (droits pour character) ni d'appel à character.
INTERNAL_API_SECRET=dev-secret-interne-local-0123456789abcdef
# Personnages (character) : engagement, initiative et décompte des durées du combat
CHARACTER_URL=http://localhost:3002
# Profils publics des membres (noms, avatars). Vide : noms des membres vides.
IDENTITY_URL=http://localhost:3001

# URL publique du front : liens d'invitation <APP_URL>/join/<code>
APP_URL=http://localhost:3000
# Tentatives pour rejoindre une campagne, par minute et par IP
RATE_LIMIT_JOIN_MAX=20
# Messages de discussion par minute, par membre et par campagne
RATE_LIMIT_MESSAGES_MAX=20

# Images des campagnes : SeaweedFS en dev (`pnpm dev --stockage`), R2 en prod.
# Mêmes valeurs que backend/identity/.env (même bucket, dossier campaigns/).
S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_BUCKET=vtt-dev
# SeaweedFS local tourne sans authentification : ces valeurs de dev suffisent.
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev-secret
# URL publique des fichiers envoyés (CDN R2 en prod).
S3_PUBLIC_URL=http://localhost:8333/vtt-dev
# Bibliothèque d'images du produit : couvertures proposées à la création (vide : aucune)
PRESET_IMAGES_URL=https://assets.yner.fr/

# Fichiers orphelins (docs/nettoyage.md § Fichiers) : les autres services qui gardent des
# adresses de fichiers ; ORPHAN_SWEEP : off, dry-run (journalise sans supprimer), on
STORAGE_REFERENCE_URLS=http://localhost:3002,http://localhost:3001,http://localhost:3004
ORPHAN_SWEEP=dry-run
# Requêtes par minute et par IP pour ce service (300 en prod ; large en local : les tests de
# bout en bout tournent tous depuis la même adresse)
RATE_LIMIT_MAX=3000
