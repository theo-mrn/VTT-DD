# Copié en .env par `pnpm dev` s'il manque.
PORT=3003
# Rôle du service (données uniquement) ; le schéma « campaign » est migré par Liquibase
DATABASE_URL=postgres://campaign_svc:campaign-dev@localhost:5432/vtt
# Jetons d'accès émis par identity, vérifiés par son JWKS (mêmes valeurs que la gateway)
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=vtt-api
JWKS_URL=http://localhost:3001/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Secret partagé entre services (en-tête x-internal-secret), 32 caractères minimum :
# même valeur dans backend/character/.env, backend/identity/.env et backend/gateway/.env.
# Vide : pas de route interne (droits pour character) ni d'appel à character.
INTERNAL_API_SECRET=dev-secret-interne-local-0123456789abcdef
# Personnages (character) : engagement, initiative et décompte des durées du combat
CHARACTER_URL=http://localhost:3002
# Profils publics des membres (noms, avatars). Vide : noms des membres vides.
IDENTITY_URL=http://localhost:3001

# URL publique du front : liens d'invitation <APP_URL>/rejoindre/<code>
APP_URL=http://localhost:3000
# Tentatives pour rejoindre une salle, par minute et par IP
RATE_LIMIT_REJOINDRE_MAX=20
