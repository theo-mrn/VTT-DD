# Copié en .env par `pnpm dev` s'il manque.
PORT=3002
# Rôle du service (données uniquement) ; le schéma « characters » est migré par Liquibase
DATABASE_URL=postgres://characters_svc:characters-dev@localhost:5432/vtt
# Jetons d'accès émis par identity, vérifiés par son JWKS (mêmes valeurs que la gateway)
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=vtt-api
JWKS_URL=http://localhost:3001/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Actions (jets de dés) par minute et par IP
RATE_LIMIT_ACTIONS_MAX=120

# Secret partagé entre services (en-tête x-internal-secret), 32 caractères minimum :
# même valeur dans backend/campaign/.env, backend/identity/.env et backend/gateway/.env.
# Vide : pas de route interne (combat de campaign) ni de droits de MJ.
INTERNAL_API_SECRET=dev-secret-interne-local-0123456789abcdef
# Campagnes (campaign) : droits des MJ et des joueurs sur les personnages engagés
CAMPAIGN_URL=http://localhost:3003
