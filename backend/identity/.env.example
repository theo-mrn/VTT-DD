# Copié en .env par `pnpm dev:identity` (qui y ajoute une clé JWT générée).
PORT=3001
DATABASE_URL=postgres://identity_svc:identity-dev@localhost:5432/vtt
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=vtt-api
# JWT_PRIVATE_JWKS=  (générée automatiquement, jamais commitée)
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Paramètres de hachage du projet Firebase (console Firebase > Authentication >
# Utilisateurs > menu ⋮ > « Paramètres de hachage du mot de passe »).
# Nécessaires pour que les comptes importés se connectent avec leur ancien mot de passe.
FIREBASE_SCRYPT_SIGNER_KEY=
FIREBASE_SCRYPT_SALT_SEPARATOR=
FIREBASE_SCRYPT_ROUNDS=
FIREBASE_SCRYPT_MEM_COST=

# Secret partagé avec la gateway pour la route interne d'échange des clés d'API.
# Même valeur que INTERNAL_API_SECRET dans backend/gateway/.env, 32 caractères minimum.
# Vide : la route /internal/api-keys/exchange n'existe pas.
INTERNAL_API_SECRET=dev-secret-interne-local-0123456789abcdef

# URL publique du front : liens des e-mails et retour après connexion Google/Discord.
APP_URL=http://localhost:3000

# E-mails : Mailpit en dev (`pnpm dev --mails`, interface sur :8025). Vide : e-mails journalisés.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=YNER <contact@yner.fr>

# Stockage des avatars et bannières : SeaweedFS en dev (`pnpm dev --stockage`), R2 en prod.
S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_BUCKET=vtt-dev
# SeaweedFS local tourne sans authentification : ces valeurs de dev suffisent.
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev-secret
# URL publique des fichiers envoyés (CDN R2 en prod).
S3_PUBLIC_URL=http://localhost:8333/vtt-dev

# Connexion Google et Discord : désactivée tant que ces identifiants sont vides.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
