{
  "title": "VTT · Logs",
  "uid": "vtt-logs",
  "tags": ["vtt", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Source",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "app",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "query": {
          "label": "app",
          "stream": "{namespace=\"vtt-staging\"}",
          "type": 1
        },
        "definition": "label_values({namespace=\"vtt-staging\"}, app)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "search",
        "label": "Recherche",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Lignes de log",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({namespace=\"vtt-staging\", app=~\"$app\"} [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["sum"]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Erreurs",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({namespace=\"vtt-staging\", app=~\"$app\"} | json | level=\"error\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["sum"]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Réponses 5xx",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({namespace=\"vtt-staging\", app=~\"$app\"} | json | message=\"request completed\" | res_statusCode >= 500 [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["sum"]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Événements métier",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({namespace=\"vtt-staging\", app=~\"$app\"} | json | eventId != \"\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "description": "Une ligne par changement d'état, écrite par le relais d'outbox après le COMMIT (docs/observabilite.md § 2).",
      "options": {
        "reduceOptions": {
          "calcs": ["sum"]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Volume de logs par service",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (app) (count_over_time({namespace=\"vtt-staging\", app=~\"$app\"} [$__interval]))",
          "queryType": "range",
          "legendFormat": "{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["sum"]
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Erreurs et avertissements",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (app, level) (count_over_time({namespace=\"vtt-staging\", app=~\"$app\"} | json | level=~\"error|warn\" [$__interval]))",
          "queryType": "range",
          "legendFormat": "{{app}} · {{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["sum"]
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latence p95 par service",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "quantile_over_time(0.95, {namespace=\"vtt-staging\", app=~\"$app\"} | json | message=\"request completed\" | unwrap responseTime [$__interval]) by (app)",
          "queryType": "range",
          "legendFormat": "{{app}}"
        }
      ],
      "description": "Temps de réponse Fastify (responseTime), lignes « request completed ».",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "max"]
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Réponses par statut HTTP",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (res_statusCode) (count_over_time({namespace=\"vtt-staging\", app=~\"$app\"} | json | message=\"request completed\" [$__interval]))",
          "queryType": "range",
          "legendFormat": "{{res_statusCode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["sum"]
        }
      }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Refus par code métier",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (app, code) (count_over_time({namespace=\"vtt-staging\", app=~\"$app\"} | json | message=\"request rejected\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{app}} · {{code}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "namePlacement": "left"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Événements métier par type",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (type) (count_over_time({namespace=\"vtt-staging\", app=~\"$app\"} | json | eventId != \"\" [$__interval]))",
          "queryType": "range",
          "legendFormat": "{{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["sum"]
        }
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Erreurs et avertissements (détail)",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{namespace=\"vtt-staging\", app=~\"$app\"} | json | level=~\"error|warn\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      }
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Recherche (texte, request_id, trace_id…)",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{namespace=\"vtt-staging\", app=~\"$app\"} |= \"$search\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Requêtes récentes",
      "description": "Traces des requêtes HTTP (spans serveur), sans les requêtes de fond du relais d'outbox. Clic sur une trace : sa cascade de services.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ kind = server && resource.service.name =~ \"${app:regex}\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "Requêtes lentes (> 500 ms)",
      "description": "Requêtes HTTP de plus de 500 ms.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ kind = server && resource.service.name =~ \"${app:regex}\" && duration > 500ms }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 15,
      "type": "table",
      "title": "Requêtes en erreur",
      "description": "Spans en erreur (exceptions, réponses 5xx).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ status = error && resource.service.name =~ \"${app:regex}\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
