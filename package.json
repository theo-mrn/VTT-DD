{
  "name": "vtt-dd",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "bash infra/local/up.sh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "bash infra/postgres/liquibase/migrate.sh",
    "import:firebase": "bash infra/local/import-firebase.sh",
    "prepare": "husky || true",
    "dev:down": "docker compose -f infra/local/docker-compose.yml --profile \"*\" down",
    "dev:legacy": "pnpm --filter @vtt/legacy dev",
    "import:personnages": "bash infra/local/import-personnages.sh",
    "import:campaigns": "bash infra/local/import-campaigns.sh",
    "import:dice": "bash infra/local/import-dice.sh",
    "import:history": "bash infra/local/import-history.sh",
    "import:billing": "bash infra/local/import-billing.sh",
    "import:audio": "bash infra/local/import-audio.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "^5.9.3",
    "tsx": "^4.20.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
